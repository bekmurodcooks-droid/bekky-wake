<Window x:Class="BekkyWake.UI.FloatingPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BekkyWake.UI"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border x:Name="PillBorder"
            Background="#EE222529"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="10,6"
            Margin="4"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Canvas x:Name="OpenEye">
                        <Path Data="M1.5 12 C7 4.5 17 4.5 22.5 12 C17 19.5 7 19.5 1.5 12 Z"
                              Stroke="#E6E3DD" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7" Height="7" Fill="#E6E3DD"/>
                        <Path Data="M4.5499 6.1977 L3.1442 3.8341 M8.2636 4.6218 L7.5468 1.9668 M12 4.125 L12 1.375 M15.7364 4.6218 L16.4532 1.9668 M19.4501 6.1977 L20.8558 3.8341"
                              Stroke="#E6E3DD" StrokeThickness="1.7" StrokeStartLineCap="Round"/>
                    </Canvas>
                    <Canvas x:Name="ClosedEye" Visibility="Collapsed">
                        <Path Data="M2 11.5 C7.2 17.2 16.8 17.2 22 11.5"
                              Stroke="#9CA3AF" StrokeThickness="1.9" StrokeStartLineCap="Round"/>
                    </Canvas>
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="PillText"
                       Text="bekky-wake"
                       Foreground="{StaticResource BrushText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <ui:HoldToEndButton x:Name="PillHoldToEnd"
                                Margin="7,0,0,0"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
