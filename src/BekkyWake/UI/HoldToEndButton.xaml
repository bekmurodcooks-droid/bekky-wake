<UserControl x:Class="BekkyWake.UI.HoldToEndButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="24" Height="24"
             ToolTip="Hold 0.6s to end session"
             Cursor="Hand">
    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ScaleTx" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Ellipse x:Name="HoverFill" Width="22" Height="22" Fill="#00FFFFFF"/>
        <Ellipse Width="20" Height="20" Stroke="#45E6E3DD" StrokeThickness="1.8"/>
        <Path x:Name="ProgressArc" Stroke="#A6BBC3" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M 9,9 L 15,15 M 15,9 L 9,15"
              Stroke="#E6E3DD"
              StrokeThickness="1.6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>
    </Grid>
</UserControl>
