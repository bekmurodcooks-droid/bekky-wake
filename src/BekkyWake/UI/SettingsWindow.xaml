<Window x:Class="BekkyWake.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="bekky-wake Settings"
        Width="560"
        Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushDeep}"
        Foreground="{StaticResource BrushText}"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#141619"/>
            <Setter Property="Foreground" Value="#141619"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- General Section -->
            <TextBlock Text="GENERAL" Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Tray &amp; bar style" VerticalAlignment="Center" FontSize="12.5"/>
                        <ComboBox x:Name="TrayModeBox" HorizontalAlignment="Right" SelectionChanged="TrayModeChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Default session length (one-click &amp; Minimal)" VerticalAlignment="Center" FontSize="12.5"/>
                        <ComboBox x:Name="DefaultPresetBox" HorizontalAlignment="Right" SelectionChanged="DefaultPresetChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Countdown readout" VerticalAlignment="Center" FontSize="12.5"/>
                        <ComboBox x:Name="CountdownStyleBox" HorizontalAlignment="Right" SelectionChanged="CountdownStyleChanged"/>
                    </Grid>
                    <CheckBox x:Name="OneClickCheck" Content="Start default session with one left-click (Alt+Click opens menu)" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="ShowFloatingCountdownCheck" Content="Show countdown text on Floating Pill" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="KeepScreenAwakeCheck" Content="Prevent display sleep &amp; Modern Standby freeze during sessions (Recommended for AI agents)" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="SoundsCheck" Content="Play subtle tone on manual start or end" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="LaunchAtLoginCheck" Content="Launch bekky-wake automatically when signing into Windows" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                </StackPanel>
            </Border>

            <!-- Lid Close Section -->
            <TextBlock Text="WHEN THE LID CLOSES (ACTIVE SESSION, NO EXTERNAL MONITOR)" Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="MuteLidCheck" Content="Mute audio outputs and restore per-device volume on lid open" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="DarkenDisplayCheck" Content="Dim display brightness to 0% while lid is closed" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="LowPowerLidCheck" Content="Enable Windows Battery Saver while lid is closed (off by default so AI agents run unthrottled)" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="LockScreenCheck" Content="Lock Windows screen on lid close (does not auto-unlock)" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="DockerRuleCheck" Content="Pause Docker Desktop UI when no containers are running" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="AppsSummaryText" Text="Freeze rules..." Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        <Button Content="Edit Apps…" Style="{StaticResource ChipButtonStyle}" HorizontalAlignment="Right" Click="EditAppsClicked"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Battery & Heat Section -->
            <TextBlock Text="BATTERY &amp; THERMAL SAFETY FLOORS" Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Turn on Low Power Mode on battery below" VerticalAlignment="Center" FontSize="12.5"/>
                        <ComboBox x:Name="LowPowerFloorBox" HorizontalAlignment="Right" SelectionChanged="LowPowerFloorChanged"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Auto-end session (and sleep if lid shut) below" VerticalAlignment="Center" FontSize="12.5"/>
                        <ComboBox x:Name="EndFloorBox" HorizontalAlignment="Right" SelectionChanged="EndFloorChanged"/>
                    </Grid>
                    <CheckBox x:Name="ThermalRulesCheck" Content="Enable thermal protection (Low Power at 82°C, end session at 92°C)" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <CheckBox x:Name="ThermalHoldCheck" Content="Keep Low Power Mode on until cooled back to Nominal (&lt; 72°C)" Style="{StaticResource DarkCheckBoxStyle}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                    <TextBlock x:Name="HardwareReadoutText" Foreground="{StaticResource BrushMuted}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Recovery & Diagnostics Section -->
            <TextBlock Text="CRASH RECOVERY &amp; DIAGNOSTICS" Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="BackstopStatusText" Foreground="{StaticResource BrushText}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DataDirText" Foreground="{StaticResource BrushMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Logs Folder" Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0" Click="OpenLogsClicked"/>
                        <Button Content="Verify / Register Backstop" Style="{StaticResource ChipButtonStyle}" Click="RegisterBackstopClicked"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
