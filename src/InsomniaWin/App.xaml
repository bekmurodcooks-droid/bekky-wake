<Application x:Class="InsomniaWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BgDeep">#181A1D</Color>
            <Color x:Key="BgSurface">#222529</Color>
            <Color x:Key="BgMidnight">#303336</Color>
            <Color x:Key="BgChip">#2D3136</Color>
            <Color x:Key="BgChipHover">#3A3F46</Color>
            <Color x:Key="BgChipPressed">#454B53</Color>
            <Color x:Key="BorderHairline">#383D43</Color>
            <Color x:Key="TextMoon">#E6E3DD</Color>
            <Color x:Key="TextMuted">#9CA3AF</Color>
            <Color x:Key="AccentSilverViolet">#A6BBC3</Color>
            <Color x:Key="AccentSilverHover">#B9CCD3</Color>
            <Color x:Key="StatusWarning">#F59E0B</Color>
            <Color x:Key="StatusError">#EF4444</Color>

            <SolidColorBrush x:Key="BrushDeep" Color="{StaticResource BgDeep}"/>
            <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource BgSurface}"/>
            <SolidColorBrush x:Key="BrushMidnight" Color="{StaticResource BgMidnight}"/>
            <SolidColorBrush x:Key="BrushChip" Color="{StaticResource BgChip}"/>
            <SolidColorBrush x:Key="BrushChipHover" Color="{StaticResource BgChipHover}"/>
            <SolidColorBrush x:Key="BrushChipPressed" Color="{StaticResource BgChipPressed}"/>
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderHairline}"/>
            <SolidColorBrush x:Key="BrushText" Color="{StaticResource TextMoon}"/>
            <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource TextMuted}"/>
            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource AccentSilverViolet}"/>
            <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource AccentSilverHover}"/>
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource StatusWarning}"/>
            <SolidColorBrush x:Key="BrushError" Color="{StaticResource StatusError}"/>

            <Style x:Key="ChipButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushChip}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushChipHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushChipPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ProminentButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                <Setter Property="Foreground" Value="#141619"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PlainLinkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#141619"/>
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
