<Window x:Class="InsomniaWin.UI.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:InsomniaWin.UI"
        Width="324"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border Margin="8"
            Background="{StaticResource BrushDeep}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Scrollable upper content capped nicely for smaller screens -->
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,14,14,12">
                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <!-- Open eye -->
                                <Canvas x:Name="OpenEyeGroup">
                                    <Path Data="M1.5 12 C7 4.5 17 4.5 22.5 12 C17 19.5 7 19.5 1.5 12 Z"
                                          Stroke="#E6E3DD" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M15.3953 9.8853 C16.5632 11.7605 15.9899 14.2274 14.1147 15.3953 C12.2395 16.5632 9.7726 15.9899 8.6047 14.1147 C7.4368 12.2395 8.0101 9.7726 9.8853 8.6047 C11.1798 7.7984 12.8202 7.7984 14.1147 8.6047 C13.3441 8.5414 12.6681 9.1147 12.6047 9.8853 C12.5414 10.6559 13.1147 11.3319 13.8853 11.3953 C14.6559 11.4586 15.3319 10.8853 15.3953 10.1147 Z"
                                          Fill="#E6E3DD"/>
                                    <Path Data="M4.5499 6.1977 L3.1442 3.8341 M8.2636 4.6218 L7.5468 1.9668 M12 4.125 L12 1.375 M15.7364 4.6218 L16.4532 1.9668 M19.4501 6.1977 L20.8558 3.8341"
                                          Stroke="#E6E3DD" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <!-- Closed eye -->
                                <Canvas x:Name="ClosedEyeGroup" Visibility="Collapsed">
                                    <Path Data="M2 11.5 C7.2 17.2 16.8 17.2 22 11.5"
                                          Stroke="#9CA3AF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M6.4 14.9 L5.2 17.7 M12 15.8 L12 18.9 M17.6 14.9 L18.8 17.7"
                                          Stroke="#9CA3AF" StrokeThickness="1.7" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Canvas>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle"
                                       Text="InsomniaWin"
                                       Foreground="{StaticResource BrushText}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="HeaderSubtitle"
                                       Text="Not active · Lid sleep normal"
                                       Foreground="{StaticResource BrushMuted}"
                                       FontSize="11.5"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <ui:HoldToEndButton x:Name="HoldToEndBtn"
                                            Grid.Column="2"
                                            Visibility="Collapsed"
                                            VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,12,0,10"/>

                    <!-- Presets / Extend chips -->
                    <TextBlock x:Name="ChipsHeading"
                               Text="STAY AWAKE FOR"
                               Foreground="{StaticResource BrushMuted}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <WrapPanel x:Name="ChipsPanel" Orientation="Horizontal"/>

                    <!-- Custom duration panel -->
                    <Border x:Name="CustomDurationPanel"
                            Visibility="Collapsed"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Days" Foreground="{StaticResource BrushMuted}" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="DaysInput" Style="{StaticResource DarkTextBoxStyle}" Text="0" TextAlignment="Center" PreviewTextInput="NumericOnly" KeyDown="CustomFieldKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hours" Foreground="{StaticResource BrushMuted}" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="HoursInput" Style="{StaticResource DarkTextBoxStyle}" Text="4" TextAlignment="Center" PreviewTextInput="NumericOnly" KeyDown="CustomFieldKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Mins" Foreground="{StaticResource BrushMuted}" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="MinutesInput" Style="{StaticResource DarkTextBoxStyle}" Text="0" TextAlignment="Center" PreviewTextInput="NumericOnly" KeyDown="CustomFieldKeyDown"/>
                            </StackPanel>
                            <Button x:Name="CustomCommitBtn"
                                    Grid.Column="6"
                                    Content="Start"
                                    Style="{StaticResource ProminentButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Padding="12,6"
                                    Click="CustomCommitClicked"/>
                        </Grid>
                    </Border>

                    <!-- Error Banner -->
                    <Border x:Name="ErrorBanner"
                            Visibility="Collapsed"
                            Background="#28EF4444"
                            BorderBrush="#66EF4444"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="9,7"
                            Margin="0,10,0,0">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="#FCA5A5"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Status & Hardware Badges -->
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,12,0,10"/>
                    <WrapPanel x:Name="StatusBadgesPanel" Orientation="Horizontal"/>

                    <!-- Warnings and Actions -->
                    <StackPanel x:Name="AlertsPanel" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Settings…" Style="{StaticResource PlainLinkButtonStyle}" Click="SettingsClicked"/>
                        <Border x:Name="SimBadge"
                                Visibility="Collapsed"
                                Background="#26A6BBC3"
                                CornerRadius="8"
                                Padding="6,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Lid simulation watcher enabled">
                            <TextBlock Text="Sim" Foreground="{StaticResource BrushAccent}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Quit" Style="{StaticResource PlainLinkButtonStyle}" Click="QuitClicked"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
